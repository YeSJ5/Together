# TOGETHER Backend Environment Configuration
PORT=5000
CLIENT_ORIGIN=https://together-puce.vercel.app

# Database Persistence (Leave unset for local SQLite fallback; provide for managed PostgreSQL cloud durability)
# Example: postgresql://together_user:secret@dpg-xxxxx-a.oregon-postgres.render.com/together
DATABASE_URL=

# Network Traversal & NAT Traversal (STUN / TURN)
# STUN URLs (comma-separated, defaults to Google & Twilio public STUN if unset)
STUN_URLS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478

# Real TURN Relay (RFC 5766 REST API dynamic HMAC-SHA1 credentials or static credentials)
# Example: turn:turn.together.live:3478,turns:turn.together.live:5349
TURN_URLS=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional SFU Transport (LiveKit) for > 8-10 peers
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_DEFAULT_ROOM_PREFIX=together
